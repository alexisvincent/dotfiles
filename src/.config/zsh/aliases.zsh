# Enable aliases to be sudo’ed
alias sudo='sudo '

alias cat=bat
alias ls=lsd
alias p=pnpm
alias l='ls -lah'
alias la='ls -lAh'
alias ll='ls -lh'
alias grep='grep --color=auto'
alias tailscale="/Applications/Tailscale.app/Contents/MacOS/Tailscale"
alias claude="claude --allow-dangerously-skip-permissions"

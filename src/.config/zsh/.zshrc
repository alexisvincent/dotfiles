source $ZDOTDIR/setup.zsh
source $ZDOTDIR/aliases.zsh

# Completions generated by the tools themselves
source <(kubectl completion zsh)
[ -s ~/.bun/_bun ] && source ~/.bun/_bun
if [ -f ~/.local/google-cloud-sdk/completion.zsh.inc ]; then . ~/.local/google-cloud-sdk/completion.zsh.inc; fi
if (( $+commands[docker] )); then
  [ -s ~/.cache/zsh/_docker ] || { mkdir -p ~/.cache/zsh && docker completion zsh > ~/.cache/zsh/_docker; }
  source ~/.cache/zsh/_docker
  compdef _docker docker
fi

source ~/.private/privaterc

source <(fzf --zsh)
eval "$(direnv hook zsh)"
eval "$(starship init zsh)"

# PATH, again: macOS's /etc/zprofile (path_helper) runs after .zshenv and
# moves the system folders first, so put these back in front.
eval "$(/opt/homebrew/bin/brew shellenv)"
export PATH="$HOME/.local/bin:$PATH"
export PATH="${KREW_ROOT:-$HOME/.krew}/bin:$PATH"
if [ -n "$REX_BIN_DIR" ]; then
    export PATH="$REX_BIN_DIR:$PATH"
fi

# Plugins (syntax highlighting must come last)
source $ZDOTDIR/plugins/zsh-z/zsh-z.plugin.zsh
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#aaaaaa"
source $ZDOTDIR/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
source $ZDOTDIR/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
